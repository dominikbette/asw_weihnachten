# Kopie als ".env" speichern und Werte eintragen. Die Datei .env wird nicht ins Repository übernommen.
SMTP_HOST=smtp.example.org
# 587 = STARTTLS (Standard), 465 = SSL
SMTP_PORT=587
SMTP_USER=name@example.org
SMTP_PASSWORD=dein-passwort-oder-app-passwort
# Optional, Standard: SMTP_USER
MAIL_FROM=name@example.org
